# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# These are the environment variables you need
# to set in Railway Dashboard → Variables tab
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# ============================================
# MySQL Database (Railway auto-sets these when
# you add a MySQL service — no manual input needed!)
# ============================================
# MYSQLHOST=auto-set-by-railway
# MYSQLPORT=auto-set-by-railway
# MYSQLUSER=auto-set-by-railway
# MYSQLPASSWORD=auto-set-by-railway
# MYSQLDATABASE=auto-set-by-railway
# MYSQL_URL=auto-set-by-railway

# ============================================
# YOU MUST SET THESE MANUALLY in Railway:
# ============================================

# Session Secret (generate a strong random string!)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Cookie Configuration
COOKIE_MAX_AGE=86400000

# Cloudinary Configuration (for avatar & file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
